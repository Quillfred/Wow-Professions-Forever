<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- A gathering spot on the world map: a hollow square (MapPins.lua: SkillRouteMapPinMixin) -->
  <Frame name="SkillRouteMapPinTemplate" mixin="SkillRouteMapPinMixin" virtual="true">
    <Size x="12" y="12"/>
    <Layers>
      <Layer level="OVERLAY">
        <Texture parentKey="top"><Size x="2" y="2"/><Anchors><Anchor point="TOPLEFT"/><Anchor point="TOPRIGHT"/></Anchors></Texture>
        <Texture parentKey="bottom"><Size x="2" y="2"/><Anchors><Anchor point="BOTTOMLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors></Texture>
        <Texture parentKey="left"><Size x="2" y="2"/><Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMLEFT"/></Anchors></Texture>
        <Texture parentKey="right"><Size x="2" y="2"/><Anchors><Anchor point="TOPRIGHT"/><Anchor point="BOTTOMRIGHT"/></Anchors></Texture>
      </Layer>
    </Layers>
    <Scripts>
      <!-- only OnLoad: the map sets OnEnter/OnLeave itself (it asserts they're unset) and calls
           the mixin's OnMouseEnter/OnMouseLeave -->
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
