<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- A gathering spot on the world map: a small dot with a dark rim (MapPins.lua: SkillRouteMapPinMixin) -->
  <Frame name="SkillRouteMapPinTemplate" mixin="SkillRouteMapPinMixin" virtual="true">
    <Size x="7" y="7"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="rim" setAllPoints="true"/>
      </Layer>
      <Layer level="OVERLAY">
        <Texture parentKey="dot">
          <Anchors>
            <Anchor point="TOPLEFT" x="1" y="-1"/>
            <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <!-- only OnLoad: the map sets OnEnter/OnLeave itself (it asserts they're unset) and calls
           the mixin's OnMouseEnter/OnMouseLeave -->
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
